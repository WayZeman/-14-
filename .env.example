# Neon Postgres — pooled (app / Vercel serverless)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres — direct (drizzle-kit migrate / push)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing (openssl rand -hex 32)
AUTH_SECRET=""

# First admin (seed). Change password after first login.
ADMIN_BOOTSTRAP_EMAIL="admin@14orb.local"
ADMIN_BOOTSTRAP_PASSWORD=""

# Public site URL (production: https://14orb.co.ua)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google Search Console → Settings → Ownership verification → HTML tag
# Paste only the content= value, e.g. abCdEf123...
GOOGLE_SITE_VERIFICATION=""
